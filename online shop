<!DOCTYPE html>
<html>
<head>
<title>Online Shop</title>

<style>
body{
    font-family: Arial;
    margin:0;
    background:#f4f4f4;
}

header{
    background:#222;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#333;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    margin:15px;
    text-decoration:none;
}

.products{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
    padding:30px;
}

.card{
    background:white;
    width:250px;
    padding:20px;
    text-align:center;
    box-shadow:0 0 10px gray;
    border-radius:10px;
}

.card img{
    width:150px;
    height:150px;
}

button{
    background:#008cff;
    color:white;
    border:none;
    padding:10px 20px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#005bbb;
}

.cart{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;
}
</style>

</head>

<body>

<header>
<h1>My Online Shop</h1>
<p>Shopping Made Easy</p>
</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Contact</a>
<a href="#">Cart (<span id="count">0</span>)</a>
</nav>


<section class="products">

<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Mobile Phone</h2>
<p>Price: ₹15000</p>
<button onclick="addCart('Mobile Phone')">Add Cart</button>
</div>


<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Laptop</h2>
<p>Price: ₹50000</p>
<button onclick="addCart('Laptop')">Add Cart</button>
</div>


<div class="card">
<img src="https://via.placeholder.com/150">
<h2>Headphone</h2>
<p>Price: ₹2000</p>
<button onclick="addCart('Headphone')">Add Cart</button>
</div>

</section>


<div class="cart">
<h2>Your Cart</h2>
<ul id="cartList"></ul>
</div>


<script>

let count = 0;

function addCart(product){

count++;

document.getElementById("count").innerHTML=count;

let li=document.createElement("li");
li.innerHTML=product;

document.getElementById("cartList").appendChild(li);

}

</script>


</body>
</html>
